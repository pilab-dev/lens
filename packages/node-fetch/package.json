{
  "name": "@openlens/node-fetch",
  "version": "6.5.0",
  "description": "Node fetch for Lens",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist/",
    "build": "esbuild index.ts --bundle --platform=node --target=es2019 --outfile=dist/index.cjs --packages=external && tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist",
    "dev": "esbuild index.ts --bundle --platform=node --target=es2019 --outfile=dist/index.cjs --packages=external --watch"
  },
  "dependencies": {
    "node-fetch": "^3.3.0"
  },
  "devDependencies": {
    "@openlens/webpack": "workspace:*",
    "rimraf": "^4.4.1"
  }
}
