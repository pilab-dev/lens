{
  "name": "@openlens/run-many",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "A package containing runMany and runManySync",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": {
    "name": "OpenLens Maintainers",
    "email": "f.baldo31@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Open-Lens/app",
  "scripts": {
    "clean": "rimraf dist/",
    "build": "esbuild index.ts --bundle --platform=node --target=es2019 --outfile=dist/index.js --packages=external && tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist",
    "dev": "esbuild index.ts --bundle --platform=node --target=es2019 --outfile=dist/index.js --packages=external --watch",
    "test:unit": "jest --coverage --runInBand"
  },
  "peerDependencies": {
    "@openlens/test-utils": "workspace:*",
    "@openlens/utilities": "workspace:*",
    "@ogre-tools/fp": "^16.1.0",
    "@ogre-tools/injectable": "^16.1.0",
    "type-fest": "^2.19.0",
    "typed-emitter": "^1.4.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@openlens/webpack": "workspace:*",
    "@types/uuid": "^9.0.1"
  }
}
