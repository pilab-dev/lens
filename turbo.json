{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT", "tsconfig.json", "tsconfig/**/*.json", "src/**", "index.ts", "webpack.config.*", ".swcrc"],
      "outputs": ["dist/**", "build/**", "static/build/**", "lib/**"]
    },
    "build:app": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "static/build/**"]
    },
    "build:docs": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT", "src/**", "jest.config.*", ".swcrc"],
      "outputs": ["coverage/**"]
    },
    "test:unit:watch": {
      "cache": false,
      "interactive": true
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT", "src/**", "integration/**"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT", ".eslintrc*", ".prettierrc*"]
    },
    "lint:fix": {
      "inputs": ["$TURBO_DEFAULT", ".eslintrc*", ".prettierrc*"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
